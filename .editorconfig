root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4

[*.{json,yaml,yml,md}]
indent_style = space
indent_size = 2

[tests/golden/*]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
